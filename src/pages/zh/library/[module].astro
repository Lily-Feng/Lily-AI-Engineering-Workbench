---
/** Chinese module pages, one per modules/<id>.md. The English twin is src/pages/library/[module].astro. */
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import ModuleOutline from '../../../components/ModuleOutline.astro';
import { readCatalog } from '../../../lib/catalog.mjs';

export async function getStaticPaths() {
  return (await readCatalog()).map((module) => ({ params: { module: module.id }, props: { module } }));
}

const { module } = Astro.props;
---

<StarlightPage frontmatter={{ title: `${module.id} · ${module.chinese}`, description: module.description }}>
  <ModuleOutline module={module} locale="zh" />
</StarlightPage>
