---
/** Homepage card summarizing the featured demo. The "2" is REVIEW.md's two human catches. */
import { run, passed, total } from './run';
import { withBase } from '../../lib/url';

const zh = Astro.locals.starlightRoute.locale === 'zh';
const href = withBase(`${zh ? 'zh/' : ''}demos/evaluation/`);
const t = zh
  ? { eyebrow: '精选演示内部', passing: '项检查通过', modes: '种失败模式', human: '个只有人工审查发现的错误', question: '测试全部通过，能证明什么？', answer: '比看起来少。完整演示会展示两面。' }
  : { eyebrow: 'Inside the featured demo', passing: 'checks passing', modes: 'failure modes covered', human: 'errors only a human caught', question: 'What does a green suite prove?', answer: 'Less than it looks. The walkthrough shows both halves.' };
---

<div class="wb not-content">
  <a class="eval-card" href={href}>
    <div class="eval-card-top"><span class="eyebrow">{t.eyebrow}</span><span class="eval-card-source">Groundwork</span></div>
    <dl class="eval-stats">
      <div><dt>{passed}/{total}</dt><dd>{t.passing}</dd></div>
      <div><dt>{run.categories.length}</dt><dd>{t.modes}</dd></div>
      <div><dt>2</dt><dd>{t.human}</dd></div>
    </dl>
    <div class="eval-card-caption"><span><strong>{t.question}</strong><small>{t.answer}</small></span><span class="circle-arrow" aria-hidden="true">↗</span></div>
  </a>
</div>
